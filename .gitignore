# Data — acquired via src/data/, never committed (IMD GRD ~490 MB, IWB caches).
# Loaders recreate these directories and re-fetch on demand.
/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# HuggingFace / fsspec local caches
.cache/
*.lock

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Notebooks
.ipynb_checkpoints/

# Artifacts: keep the Phase 1 gate evidence (referenced by DISCUSSION D-14),
# ignore anything larger that future runs might drop here.
/artifacts/*
!/artifacts/phase1_run_log.txt
!/artifacts/phase1_stage1_validation.json
!/artifacts/phase1_*_per_year_lead*.csv
!/artifacts/d15_bulletin_samples.txt
!/artifacts/phase1r_trough_check.txt
!/artifacts/stage1_prior_schema.txt
!/artifacts/stage2_backtest.txt
!/artifacts/stage4_decision_example.txt
!/artifacts/delivery_demo_2018.txt
!/artifacts/delivery_risk_indicator_2018.svg
!/artifacts/demo_2018_endtoend.txt
!/artifacts/demo_2018_endtoend_run.txt
!/artifacts/demo_2018_risk.svg
!/artifacts/demo_2018_snapshot.html
